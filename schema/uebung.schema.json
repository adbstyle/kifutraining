{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Übung",
  "type": "object",
  "required": ["id", "name", "trainingsteil", "kategorien", "quelle"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "trainingsteil": { "enum": ["auffangen", "einleitung", "hauptteil", "ausklang"] },
    "erscheinungsform": {
      "type": "array",
      "items": {
        "enum": ["spiel-kreativ-gestalten", "ball-entschlossen-erobern",
                 "mutig-tore-erzielen", "mutig-tore-verhindern",
                 "flink-geschickt-bewegen", "respektvoll-fair-spielen"]
      },
      "uniqueItems": true
    },
    "feldtyp": { "enum": ["kleinfeld", "grossfeld", "freies_feld", null] },
    "spielfeld": {
      "$comment": "Länge und Breite in Metern, nur beim freien Feld (Story #272) — spiegelt ex_spielfeld_je_feld und ex_spielfeld_bereich.",
      "type": "object",
      "additionalProperties": false,
      "required": ["laenge_m", "breite_m"],
      "properties": {
        "laenge_m": { "type": "integer", "minimum": 5, "maximum": 120 },
        "breite_m": { "type": "integer", "minimum": 5, "maximum": 120 }
      }
    },
    "hauptteilkategorie": {
      "enum": ["fussball-spielen-lernen", "vielseitigkeit-erleben", "fussball-spielen"]
    },
    "kategorien": {
      "type": "array",
      "items": { "enum": ["G", "F", "E", "D", "C", "B", "A"] },
      "uniqueItems": true
    },
    "anzahl_kinder": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["integer", "null"] },
        "max": { "type": ["integer", "null"] }
      }
    },
    "material": {
      "$comment": "Freie Ergänzung: was das Feld-Diagramm nicht kennt (Epic #266).",
      "type": "array",
      "items": { "type": "string" }
    },
    "material_liste": {
      "$comment": "Material aus dem Diagramm-Vorrat nach Art, Farbe, Menge (Story #270). Arten und Farben spiegeln MATERIAL_ARTEN und farbSlugs in web/lib/material.ts bzw. web/lib/diagramm.ts; npm run check:material hält sie gleich. Farbe nur bei färbbarem Material.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["art", "menge"],
        "properties": {
          "art": {
            "enum": ["tor", "minitor", "pylone", "teller", "stange", "reifen", "huerde",
                     "leibchen", "fussball", "handball", "tennisball"]
          },
          "farbe": { "enum": ["rot", "blau", "gelb", "gruen", "orange", "weiss", "schwarz"] },
          "menge": { "type": "integer", "minimum": 1, "maximum": 999 }
        }
      }
    },
    "aufbau": { "type": "string", "minLength": 1 },
    "methodischer_fahrplan": {
      "$comment": "Alle drei Stufen sind Pflicht — spiegelt den DB-Constraint fahrplan_vollstaendig, der seit Story 2 (Epic #72) quellenunabhängig gilt. So schlägt eine lückenhafte Übung schon bei validate.py fehl und nicht erst beim Seed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["offen_starten", "ueben", "wetteifern"],
      "properties": {
        "offen_starten": { "type": "string", "minLength": 1 },
        "ueben": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "wetteifern": { "type": "string", "minLength": 1 }
      }
    },
    "varianten": { "type": "string", "minLength": 1 },
    "quelle": {
      "type": "object",
      "required": ["datei", "seite"],
      "additionalProperties": false,
      "properties": {
        "datei": { "type": "string" },
        "seite": { "type": "integer" }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Eine Spielfeldgrösse gibt es nur beim freien Feld; Kleinfeld und Grossfeld haben ihre Masse (Story #272).",
      "if": { "required": ["spielfeld"] },
      "then": {
        "properties": { "feldtyp": { "const": "freies_feld" } },
        "required": ["feldtyp"]
      }
    },
    {
      "$comment": "Ablauf-Form je Einordnung (Epic #72, Story 2): Einleitung und Hauptteil tragen den methodischen Fahrplan — ausser der Hauptteilkategorie «Fussball spielen», die als freies Spiel eine Beschreibung trägt.",
      "if": {
        "properties": { "trainingsteil": { "enum": ["einleitung", "hauptteil"] } },
        "required": ["trainingsteil"],
        "not": {
          "properties": { "hauptteilkategorie": { "const": "fussball-spielen" } },
          "required": ["hauptteilkategorie"]
        }
      },
      "then": { "required": ["methodischer_fahrplan"] }
    },
    {
      "$comment": "«Fussball spielen» trägt die Beschreibung des Spiels im Feld aufbau; ein Fahrplan ist dort unzulässig.",
      "if": {
        "properties": { "hauptteilkategorie": { "const": "fussball-spielen" } },
        "required": ["hauptteilkategorie"]
      },
      "then": {
        "required": ["aufbau"],
        "not": { "required": ["methodischer_fahrplan"] }
      }
    },
    {
      "if": {
        "properties": { "trainingsteil": { "enum": ["auffangen", "ausklang"] } }
      },
      "then": { "required": ["aufbau"] }
    },
    {
      "$comment": "Hauptteilkategorie ist genau bei Hauptteil-Übungen Pflicht (Enabler #21, AC2/AC3).",
      "if": {
        "properties": { "trainingsteil": { "const": "hauptteil" } }
      },
      "then": { "required": ["hauptteilkategorie"] },
      "else": { "not": { "required": ["hauptteilkategorie"] } }
    }
  ]
}
