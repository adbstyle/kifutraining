# Server-only Supabase-Konfiguration — KEINE NEXT_PUBLIC_-Variablen.
# Diese Werte verlassen nie den Server (Browser bekommt keine DB-Credentials).

# --- Local Dev (Werte aus `supabase start` übernehmen) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<lokaler-anon-key-aus-supabase-start>

# Nur für `npm run seed` (RLS-umgehend) — niemals in der App-Request-Pipeline:
SUPABASE_SERVICE_ROLE_KEY=<lokaler-service-role-key-aus-supabase-start>

# Bucket für Feld-Diagramme
SUPABASE_STORAGE_BUCKET=exercise-images

# Kanonischer Origin für Auth-Redirects (Magic-Link / Signup-Bestätigung).
# Lokal optional (wird sonst aus dem Request-Host abgeleitet); in PROD PFLICHT,
# sonst zeigen Bestätigungslinks auf den Host-Header bzw. die Supabase-Site-URL.
# APP_ORIGIN=http://127.0.0.1:3000

# --- Production (in Vercel als Environment-Variablen setzen, NICHT hier) ---
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<prod-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<prod-service-role>   # nur in CI/Seed-Secrets, nicht in Vercel-Runtime
# APP_ORIGIN=https://<prod-domain>                # MUSS mit Supabase Auth „Site URL" + Redirect-Allowlist übereinstimmen

# Optional: GitHub-Token für die Seite «Versionen» (#408). Ohne Token gelten die
# 60 Abrufe pro Stunde und IP der GitHub-API; KiFu ruft höchstens etwa einmal pro
# Stunde ab. Der Token braucht keine Rechte (nur öffentliche Daten) und bleibt
# auf dem Server. Kein NEXT_PUBLIC_-Präfix.
# GITHUB_TOKEN=
