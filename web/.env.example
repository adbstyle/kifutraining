# Server-only Supabase-Konfiguration — KEINE NEXT_PUBLIC_-Variablen.
# Diese Werte verlassen nie den Server (Browser bekommt keine DB-Credentials).

# --- Local Dev (Werte aus `supabase start` übernehmen) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<lokaler-anon-key-aus-supabase-start>

# Nur für `npm run seed` (RLS-umgehend) — niemals in der App-Request-Pipeline:
SUPABASE_SERVICE_ROLE_KEY=<lokaler-service-role-key-aus-supabase-start>

# Bucket für Feld-Diagramme
SUPABASE_STORAGE_BUCKET=exercise-images

# --- Production (in Vercel als Environment-Variablen setzen, NICHT hier) ---
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<prod-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<prod-service-role>   # nur in CI/Seed-Secrets, nicht in Vercel-Runtime
